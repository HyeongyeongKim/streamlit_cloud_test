diff --git a/app/schedule-rules.ts b/app/schedule-rules.ts
new file mode 100644
--- /dev/null
+++ b/app/schedule-rules.ts
@@ -0,0 +1,50 @@
+type RecordValue = Record<string, unknown>;
+const bands = ['anytime', 'morning', 'afternoon', 'night'];
+const text = (v: unknown) => typeof v === 'string' ? v.trim() : '';
+
+export function validDate(value: unknown): string {
+  const raw = text(value);
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(raw)) return '';
+  const parsed = new Date(raw + 'T00:00:00Z');
+  return !Number.isNaN(parsed.valueOf()) && parsed.toISOString().slice(0, 10) === raw ? raw : '';
+}
+
+// Merge before validating: partial updates must not leave an invalid time range.
+export function scheduleValues(data: RecordValue, current: RecordValue = {}) {
+  const readTime = (key: string, column: string) => {
+    const value = data[key] === undefined ? (current[column] ?? '') : data[key];
+    if (typeof value !== 'string' || (value !== '' && !/^([01]\d|2[0-3]):[0-5]\d$/.test(value))) {
+      throw new Error('시각은 00:00부터 23:59 사이로 입력해 주세요.');
+    }
+    return value;
+  };
+  const start = readTime('plannedStart', 'planned_start');
+  const end = readTime('plannedEnd', 'planned_end');
+  const actualStart = readTime('actualStart', 'actual_start');
+  const actualEnd = readTime('actualEnd', 'actual_end');
+  for (const [first, last] of [[start, end], [actualStart, actualEnd]]) {
+    if (last && !first) throw new Error('시작 시각을 함께 입력해 주세요.');
+    if (first && last && last <= first) throw new Error('종료 시각은 시작 시각보다 늦어야 해요. 자정을 넘는 일정은 나눠 주세요.');
+  }
+  for (const key of ['isFixed', 'shareTime']) {
+    if (data[key] !== undefined && typeof data[key] !== 'boolean') throw new Error('설정 값을 확인해 주세요.');
+  }
+  const fixed = data.isFixed === undefined ? !!current.is_fixed : data.isFixed;
+  const share = data.shareTime === undefined ? !!current.share_time : data.shareTime;
+  if (fixed && !start) throw new Error('시간이 정해진 약속에는 시작 시각이 필요해요.');
+  let band = data.timeBand === undefined ? (current.time_band ?? 'anytime') : data.timeBand;
+  if (typeof band !== 'string' || !bands.includes(band)) throw new Error('시간대를 확인해 주세요.');
+  if (start) band = start < '12:00' ? 'morning' : start < '18:00' ? 'afternoon' : 'night';
+  const note = data.note === undefined ? text(current.note) : text(data.note);
+  if (note.length > 1000) throw new Error('짧은 기록은 1000자까지 남길 수 있어요.');
+  return { time_band: band, planned_start: start, planned_end: end,
+    actual_start: actualStart, actual_end: actualEnd, is_fixed: fixed ? 1 : 0,
+    share_time: share ? 1 : 0, note };
+}
+
+export function sharedSchedule(task: RecordValue) {
+  if (task.share_time) return task;
+  // Privacy is enforced in the response, not merely by hiding UI elements.
+  return { ...task, time_band: 'anytime', planned_start: '', planned_end: '',
+    actual_start: '', actual_end: '', is_fixed: 0 };
+}
